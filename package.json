{
  "name": "tirelesstracker",
  "version": "2.0.0",
  "description": "MTGO game tracker for Magic Online players",
  "main": "main/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "package": "vite build && electron-builder",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.tirelesstracker.app",
    "productName": "Tireless Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!db/mtgo.db",
      "!src/**",
      "!tests/**",
      "!overlay/**",
      "!renderer/**",
      "!*.md",
      "!.gitignore",
      "!playwright.config.js",
      "!vitest.config.js"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdryannMillos/delverOfSecrets.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "chart.js": "^4.5.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^38.4.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
